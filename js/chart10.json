{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 540,
  "height": {
    "step": 52
  },
  "data": {
    "url": "data/queensland_digital_inclusion_opportunities_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent_of_centres": "number",
        "approx_centres": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.opportunity_type == 'Printing, copying and scanning' ? 'Printing / scanning' : datum.opportunity_type == 'Wifi' ? 'Wi-Fi' : indexof(datum.opportunity_type, 'Basic digital skills') == 0 ? 'Basic digital skills' : datum.opportunity_type == 'Computer learning lab' ? 'Computer learning lab' : indexof(datum.opportunity_type, 'Advanced digital skills') == 0 ? 'Advanced digital skills' : 'Other'",
      "as": "service_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "service_label",
      "type": "nominal",
      "sort": {
        "field": "percent_of_centres",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 195,
        "labelFontSize": 13,
        "labelPadding": 10,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "percent_of_centres",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "title": "Neighbourhood centres offering service (%)",
      "axis": {
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "grid": true,
        "labelExpr": "datum.value + '%'"
      }
    },
    "tooltip": [
      {
        "field": "opportunity_type",
        "type": "nominal",
        "title": "Digital inclusion service"
      },
      {
        "field": "percent_of_centres",
        "type": "quantitative",
        "title": "Centres offering service (%)",
        "format": ".0f"
      },
      {
        "field": "approx_centres",
        "type": "quantitative",
        "title": "Approximate number of centres",
        "format": ",.0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#8bb6d5",
        "strokeWidth": 3
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "color": "#256d9e",
        "stroke": "white",
        "strokeWidth": 1.4
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 13,
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#25384a"
      },
      "encoding": {
        "text": {
          "field": "percent_of_centres",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}