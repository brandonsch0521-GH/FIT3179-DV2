{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 650,
  "projection": {
    "type": "mercator",
    "center": [
      145,
      -21
    ],
    "scale": 900
  },
  "layer": [
    {
      "data": {
        "url": "data/queensland_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f2f3",
        "stroke": "#7d8b95",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/queensland_centre_density_2019.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": null,
        "opacity": 0.9
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "properties.density_index",
          "type": "quantitative",
          "title": "Relative centre density (0\u2013100)",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              100
            ],
            "scheme": "yelloworangered"
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 300
          }
        },
        "tooltip": [
          {
            "field": "properties.density_index",
            "type": "quantitative",
            "title": "Relative density index",
            "format": ".1f"
          },
          {
            "value": "Smoothed centre concentration; not a centre count or population rate",
            "title": "Meaning"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/queensland_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#637582",
        "strokeWidth": 1.1
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}