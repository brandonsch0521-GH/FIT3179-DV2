{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 450,
  "data": {
    "url": "data/victoria_services_2024_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent_2024": "number",
        "percent_2025": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "percent_2025",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 15"
    },
    {
      "fold": [
        "percent_2024",
        "percent_2025"
      ],
      "as": [
        "year",
        "percentage"
      ]
    },
    {
      "calculate": "datum.year == 'percent_2024' ? '2024' : '2025'",
      "as": "year_label"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "y": {
      "field": "service_type",
      "type": "nominal",
      "sort": {
        "field": "percent_2025",
        "order": "descending"
      },
      "title": null
    },
    "x": {
      "field": "year_label",
      "type": "ordinal",
      "title": "Year"
    },
    "color": {
      "field": "percentage",
      "type": "quantitative",
      "title": "% of Houses",
      "scale": {
        "scheme": "blues"
      }
    },
    "tooltip": [
      {
        "field": "service_type",
        "type": "nominal",
        "title": "Service"
      },
      {
        "field": "year_label",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Houses Providing Service (%)",
        "format": ".0f"
      }
    ]
  }
}