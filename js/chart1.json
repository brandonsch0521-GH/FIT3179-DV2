{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 320,
  "data": {
    "url": "data/victoria_program_sessions_2024_2025.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.sessions_2025)",
      "as": "sessions_numeric"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "sessions_numeric",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 15"
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "program_type",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "sessions_2025",
      "type": "quantitative",
      "title": "Number of Sessions in 2025"
    },
    "color": {
      "condition": {
        "test": "datum.rank <= 2",
        "value": "#4E79A7"
      },
      "value": "#D5D9DD"
    },
    "tooltip": [
      {
        "field": "program_type",
        "type": "nominal",
        "title": "Program"
      },
      {
        "field": "sessions_2025",
        "type": "quantitative",
        "title": "Sessions"
      }
    ]
  }
}